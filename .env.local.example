# ─── Required: Phase 1 (single workspace) ───────────────────────────────────
# From api.slack.com → Your App → Basic Information
SLACK_SIGNING_SECRET=your_signing_secret_here

# From api.slack.com → Your App → OAuth & Permissions → Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-your-bot-token-here

# ─── Required: Phase 2 (multi-workspace OAuth) ───────────────────────────────
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# The Slack OAuth install URL shown on the landing page "Add to Slack" button.
# Format: https://slack.com/oauth/v2/authorize?client_id=<CLIENT_ID>&scope=<SCOPES>&redirect_uri=https://chillscreen.com/api/slack/oauth
NEXT_PUBLIC_SLACK_INSTALL_URL=

# Neon Postgres connection string (Phase 2 only)
DATABASE_URL=

# ─── Optional ────────────────────────────────────────────────────────────────
# Only needed if you switch from hardcoded image URLs to runtime Unsplash API calls
UNSPLASH_ACCESS_KEY=


