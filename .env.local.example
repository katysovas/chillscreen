# Public site URL — used for canonical links, Open Graph, and JSON-LD.
# NEXT_PUBLIC_SITE_URL=https://whichstage.com

# PostHog analytics (client-side — project token is public by design).
# NEXT_PUBLIC_POSTHOG_KEY=phc_x5DQfWNwSCWuh22rnDjPYR3JKGBayEMnpXpQbfddTWEp
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# YouTube Data API v3 — required for API-sourced stage channels (e.g. EDC search
# playlist in lib/stageVideos.ts). Curated channels work without a key.
# https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# Admin tools (/admin/stage-playlists, /admin/npc-generator) — password-protected.
# Unset = admin routes redirect home and APIs return 403.
ADMIN_PASSWORD=

# Stage playlists live in data/stage-playlists.json — curate via admin UI.

# OpenAI API key — player-initiated NPC 1:1 chat (gpt-4.1-nano). Falls back if unset.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# OpenRouter — server-driven NPC room chatter (/api/npc-chatter). Required for NPC↔NPC convos.
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Shared secret — PartyKit sends Authorization: Bearer <secret> to /api/npc-chatter.
# Required in production (blocks public abuse of your OpenRouter key).
NPC_CHATTER_SECRET=

# Default model when an NPC has no modelId in data/npc-roster.json.
# Must be in lib/npcChatter/models.ts allowlist (low-cost only).
# HOUSE_MODEL=openai/gpt-4.1-nano

# PartyKit multiplayer room host (bare host, no protocol).
# On localhost the client always uses 127.0.0.1:1999 (`npm run party:dev`) —
# this value is only used when the app is served from a non-local host.
NEXT_PUBLIC_PARTYKIT_HOST=whichstage.katysovas.partykit.dev

# Deploy PartyKit server: npm run party:deploy

RESEND_API_KEY=re_your_key_here
