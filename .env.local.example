# YouTube Data API v3 key — required for Chill Cinema (search: "cute animals")
# https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# OpenAI API key — NPC chat (uses gpt-4o-mini). Falls back to canned replies if unset.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# PartyKit multiplayer room host (bare host, no protocol).
# Leave empty for local dev — the client defaults to 127.0.0.1:1999 (`npm run party:dev`).
# In production set this to your deployed room, e.g.:
#   NEXT_PUBLIC_PARTYKIT_HOST=chillscreen.<your-partykit-username>.partykit.dev
NEXT_PUBLIC_PARTYKIT_HOST=chillscreen.katysovas.partykit.dev
