# Neon Postgres — festies, events, conversations (https://console.neon.tech)
# Use the *pooled* connection string for Vercel/serverless.
# DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# FESTIE_SESSION_SECRET=random-32-char-string-for-sign-in-cookies


# Public site URL — used for canonical links, Open Graph, and JSON-LD.
# NEXT_PUBLIC_SITE_URL=https://whichstage.com

# PostHog analytics (client-side — project token is public by design).
# NEXT_PUBLIC_POSTHOG_KEY=phc_x5DQfWNwSCWuh22rnDjPYR3JKGBayEMnpXpQbfddTWEp
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# YouTube Data API v3 — required for API-sourced stage channels (e.g. EDC search
# playlist in lib/stageVideos.ts). Curated channels work without a key.
# https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# Admin tools (/admin/stage-playlists, /admin/npc-generator, /admin/seeds) — password-protected.
# Unset = admin routes redirect home and APIs return 403.
ADMIN_PASSWORD=

# Reddit API — recommended for /admin/seeds topic pulls (anonymous JSON is blocked).
# Create a "script" or "web app" at https://www.reddit.com/prefs/apps — redirect uri http://localhost
# Restart `npm run dev` after adding these.
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USER_AGENT=web:whichstage-seed-admin:v1.0 (by /u/yourusername)

# Stage playlists live in data/stage-playlists.json — curate via admin UI.

# OpenAI API key — player-initiated NPC 1:1 chat (gpt-4.1-nano). Falls back if unset.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# OpenRouter — NPC↔NPC pair convos. REQUIRED ON BOTH:
#   • Vercel (NEXT build /api/npc-chatter)
#   • PartyKit (pair convos call OpenRouter from the room server)
# Set in .env.local, then: npm run party:deploy
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Shared secret — PartyKit → Vercel /api/npc-chatter. Same value on both platforms.
# Required in production (blocks public abuse of your OpenRouter key).
NPC_CHATTER_SECRET=

# Vercel Cron — authorizes GET /api/cron/festie-offline-chatter (offline festie NPC chats).
# Generate a random string; Vercel sends Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=

# Optional — override chatter API URL on PartyKit (defaults to NEXT_PUBLIC_SITE_URL or whichstage.com).
# CHATTER_API_URL=https://whichstage.com/api/npc-chatter

# Default model when an NPC has no modelId on their character definition.
# Any OpenRouter model from a supported provider in lib/npcChatter/models.ts works.
# HOUSE_MODEL=openai/gpt-4.1-nano

# PartyKit multiplayer room host (bare host, no protocol).
# Used on production and on localhost when running plain `npm run dev`.
# For fully local multiplayer + NPC chatter API: npm run dev:local
NEXT_PUBLIC_PARTYKIT_HOST=whichstage.katysovas.partykit.dev

# Deploy PartyKit server: npm run party:deploy

# Resend — contact form (landing page + festie settings).
# https://resend.com/api-keys
# RESEND_API_KEY=re_...
# Verified sender on your domain (required in production):
# RESEND_FROM=WhichStage <whichstage@team.smartmetrics.com>
# Optional — defaults to support@smartmetrics.com
# CONTACT_TO=support@smartmetrics.com
