# Stage/cinema videos are predefined in lib/stageVideos.ts and played in sync
# for every user — no YouTube Data API key needed.

# OpenAI API key — NPC chat (uses gpt-4o-mini). Falls back to canned replies if unset.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# PartyKit multiplayer room host (bare host, no protocol).
# Leave empty for local dev — the client defaults to 127.0.0.1:1999 (`npm run party:dev`).
# Managed PartyKit cloud:
#   NEXT_PUBLIC_PARTYKIT_HOST=chillscreen.<your-partykit-username>.partykit.dev
# Cloud-prem (your own Cloudflare account, `npm run party:deploy:cf`):
#   NEXT_PUBLIC_PARTYKIT_HOST=partykit.<your-domain>.com
NEXT_PUBLIC_PARTYKIT_HOST=chillscreen.katysovas.partykit.dev

# Cloud-prem deploy target (custom domain configured under your Cloudflare account).
# Used by `npm run party:deploy:cf`. Requires CLOUDFLARE_ACCOUNT_ID + CLOUDFLARE_API_TOKEN
# to be set in your shell (do NOT commit those).
#   PARTYKIT_DOMAIN=partykit.<your-domain>.com
