{
  "name": "whichstage",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "dev:turbo": "next dev",
    "dev:webpack": "next dev --webpack",
    "dev:clean": "rm -rf .next && next dev --webpack",
    "build": "next build",
    "analyze": "ANALYZE=true next build",
    "start": "next start",
    "lint": "next lint",
    "party:dev": "bash -c 'set -a; [ -f .env.local ] && . ./.env.local; set +a; export PARTYKIT_DEV=true CHATTER_API_URL=${CHATTER_API_URL:-http://127.0.0.1:3000/api/npc-chatter}; exec partykit dev -p 1999'",
    "dev:local": "bash scripts/dev-local.sh",
    "dev:stop": "bash scripts/dev-stop.sh",
    "party:deploy": "bash scripts/deploy-partykit.sh",
    "party:deploy:cf": "bash scripts/deploy-partykit.sh",
    "fetch-durations": "npx tsx scripts/fetch-durations.ts",
    "db:migrate": "bash -c 'set -a; [ -f .env.local ] && . ./.env.local; set +a; node scripts/db-migrate.mjs'",
    "db:import-seeds": "bash -c 'set -a; [ -f .env.local ] && . ./.env.local; set +a; node scripts/import-chat-seeds.mjs'",
    "optimize:stage-images": "npx tsx scripts/optimize-stage-images.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1069.0",
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/blob": "^2.4.0",
    "html2canvas": "^1.4.1",
    "image-size": "^2.0.2",
    "next": "^16.2.7",
    "partysocket": "^1.1.19",
    "posthog-js": "^1.382.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^6.12.4",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.7",
    "@types/image-size": "^0.7.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.20",
    "eslint": "^9",
    "eslint-config-next": "^16.2.7",
    "partykit": "^0.0.115",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
